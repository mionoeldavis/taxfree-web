# Public site origin used for canonical URLs, hreflang, sitemap and JSON-LD
NEXT_PUBLIC_SITE_URL=https://www.example.com
# Lead/contact form endpoint (Supabase Edge Function or Formspree URL). Receives multipart form data.
NEXT_PUBLIC_FORM_ENDPOINT=
# Cloudflare Turnstile site key (optional; enables the spam challenge on forms)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Cal.com booking link, e.g. taxfree/consultation (optional; BookingEmbed falls back to the contact page)
NEXT_PUBLIC_CAL_LINK=
# Plausible domain (optional; analytics load only after cookie consent)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
